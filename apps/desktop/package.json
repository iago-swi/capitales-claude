{
  "name": "@capitales/desktop",
  "version": "0.0.0",
  "productName": "Capitales",
  "private": true,
  "description": "Capitales — world capitals quiz",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "package": "electron-builder --win --publish never",
    "icons": "node make-icons.mjs",
    "package:linux": "electron-builder --linux tar.gz --publish never",
    "package:linux:all": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@capitales/core": "*",
    "@capitales/data": "*",
    "@capitales/server": "*"
  },
  "build": {
    "appId": "ch.noth.capitales",
    "productName": "Capitales",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Capitales",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "electronVersion": "43.4.1",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons",
      "category": "Education",
      "synopsis": "World capitals quiz",
      "description": "Identify the capital of a country from its outline and a marker.",
      "executableName": "capitales"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "unpackDirName": "Capitales-${version}"
    }
  },
  "devDependencies": {
    "electron": "43.4.1",
    "esbuild": "^0.25.0",
    "electron-builder": "^26.0.0",
    "sharp": "^0.35.3",
    "png-to-ico": "^3.0.2"
  },
  "author": "Philippe Noth"
}
